#!/bin/sh
launchctl bootout system/com.vinhnv2507.chengiosroot >/dev/null 2>&1 || true
for plist in /var/jb/Library/LaunchDaemons/com.vinhnv2507.chengiosroot.plist /Library/LaunchDaemons/com.vinhnv2507.chengiosroot.plist; do
  if [ -f "$plist" ]; then
    launchctl unload "$plist" >/dev/null 2>&1 || true
    rm -f "$plist" >/dev/null 2>&1 || true
  fi
done
killall -9 chengiosroot >/dev/null 2>&1 || true
killall -9 ChengIOSApp >/dev/null 2>&1 || true

UICACHE=""
for cand in /var/jb/usr/bin/uicache /usr/bin/uicache /usr/sbin/uicache; do
  if [ -x "$cand" ]; then
    UICACHE="$cand"
    break
  fi
done
if [ -z "$UICACHE" ] && command -v uicache >/dev/null 2>&1; then
  UICACHE="uicache"
fi

if [ -n "$UICACHE" ]; then
  if [ -d /Applications/ChengIOSApp.app ]; then
    "$UICACHE" -u /Applications/ChengIOSApp.app >/dev/null 2>&1 || true
  fi
  if [ -d /var/jb/Applications/ChengIOSApp.app ]; then
    "$UICACHE" -u /var/jb/Applications/ChengIOSApp.app >/dev/null 2>&1 || true
  fi
fi

exit 0
