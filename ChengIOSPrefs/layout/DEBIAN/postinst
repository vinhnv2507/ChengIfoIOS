#!/bin/sh
echo "ChengIOS is installed!"
killall -9 Preferences >/dev/null 2>&1 || true
killall -9 ChengIOSApp >/dev/null 2>&1 || true

UICACHE=""
for cand in /var/jb/usr/bin/uicache /usr/bin/uicache /usr/sbin/uicache; do
  if [ -x "$cand" ]; then
    UICACHE="$cand"
    break
  fi
done
if [ -z "$UICACHE" ] && command -v uicache >/dev/null 2>&1; then
  UICACHE="uicache"
fi

if [ -n "$UICACHE" ]; then
  if [ -d /Applications/ChengIOSApp.app ]; then
    "$UICACHE" -p /Applications/ChengIOSApp.app >/dev/null 2>&1 || true
  fi
  if [ -d /var/jb/Applications/ChengIOSApp.app ]; then
    "$UICACHE" -p /var/jb/Applications/ChengIOSApp.app >/dev/null 2>&1 || true
  fi
fi

exit 0
